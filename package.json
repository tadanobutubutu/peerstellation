{
  "name": "peerstellation",
  "private": true,
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "npm run build-renderer",
    "dev": "vite",
    "peerstellation": "vite",
    "build-wasm": "tsx scripts/build-wasm.ts",
    "build-renderer": "tsx scripts/build-renderer.ts",
    "i18n:generate": "tsx scripts/generate-locale-packs.ts",
    "build": "npm run build-wasm && npm run build-renderer && vite build",
    "check": "npm run typecheck && npm run test:unit && vite build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:eslint": "eslint src scripts tests --max-warnings 0 --no-warn-ignored",
    "lint:fix": "biome lint --write .",
    "lint:style": "stylelint 'src/**/*.css' --max-warnings 0",
    "test:lightningcss": "tsx scripts/run-lightningcss.ts",
    "lint:markup": "markuplint index.html public/404.html --config .markuplintrc.json --max-warnings 0",
    "lint:dprint": "dprint check",
    "lint:knip": "knip --no-progress --include files,dependencies,unresolved --no-config-hints",
    "quality": "biome check .",
    "quality:all": "tsx scripts/run-quality-matrix.ts",
    "security:semgrep": "semgrep scan --config=auto --error --timeout 30",
    "security:npm": "npm audit --omit=dev --audit-level=high",
    "security:csp": "tsx scripts/run-csp-audit.ts",
    "security:csp-evaluator": "tsx scripts/run-csp-evaluator.ts",
    "security:zap": "tsx scripts/run-zap-baseline.ts",
    "test:a11y:html": "html-validate --config .htmlvalidate.json index.html public/404.html",
    "test:a11y:pa11y": "start-test 'vite --host 127.0.0.1 --port 4178' http://127.0.0.1:4178 'tsx scripts/run-pa11y.ts'",
    "test:a11y": "npm run test:a11y:html && npm run test:a11y:pa11y",
    "lint:docs": "vale README.md docs",
    "test:lighthouse": "npm run build && start-test 'vite preview --host 127.0.0.1 --port 4181 --strictPort' http://127.0.0.1:4181 'tsx scripts/run-lighthouse.ts'",
    "deploy:cloudflare": "wrangler deploy",
    "deploy:dnslink": "tsx scripts/update-dnslink.ts",
    "deploy:pinata": "tsx scripts/pin-to-pinata.ts",
    "deploy:pinata:prune": "tsx scripts/prune-pinata.ts",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:playwright-trace": "PLAYWRIGHT_TRACE=1 PLAYWRIGHT_OUTPUT_DIR=artifacts/playwright-trace playwright test tests/e2e/universe.spec.ts --grep='shows the 3D observatory immediately' --workers=1",
    "test:web-vitals": "start-test 'vite --host 127.0.0.1 --port 4178' http://127.0.0.1:4178 'tsx scripts/run-web-vitals.ts'",
    "test:purgecss": "npm run build && tsx scripts/run-purgecss.ts",
    "test:schema-parity": "tsx scripts/run-schema-parity.ts",
    "test:wasm-tools": "npm run build-wasm && tsx scripts/run-wasm-diagnostics.ts",
    "test:cypress": "start-test 'vite --host 127.0.0.1 --port 4178' http://127.0.0.1:4178 'cypress run --browser chrome'",
    "test:storybook": "storybook build --output-dir artifacts/storybook-static",
    "test:backstop": "start-test 'vite --host 127.0.0.1 --port 4178' http://127.0.0.1:4178 'tsx scripts/run-backstop.ts'",
    "test:renderer": "npm run build-renderer && start-test 'vite --host 127.0.0.1 --port 4178' http://127.0.0.1:4178 'tsx scripts/run-production-renderer-benchmark.ts'",
    "build:renderer-benchmark": "tsx scripts/build-renderer-benchmark.ts",
    "test:pagespeed": "tsx scripts/run-pagespeed.ts",
    "test:ipfs:cid": "tsx scripts/run-cid-inspector.ts",
    "test:ipfs:car": "tsx scripts/run-car-verification.ts",
    "test:ipfs:trustless": "tsx scripts/run-trustless-gateway.ts",
    "test:ipfs:origin": "tsx scripts/run-origin-isolation.ts",
    "test:ipfs:headers": "tsx scripts/run-security-headers.ts",
    "test:ipfs:spa": "tsx scripts/run-spa-routing.ts",
    "test:ipfs:ipld": "tsx scripts/run-ipld-explorer.ts",
    "test:ipfs:inspector": "tsx scripts/run-inspector.ts",
    "test:ipfs:helia-identify": "playwright test tests/e2e/universe.spec.ts --grep \"starts a real Helia browser identity\" --workers=1",
    "test:ipfs:check": "tsx scripts/run-ipfs-check.ts",
    "test:ipfs:public-gateways": "tsx scripts/run-public-gateway-checker.ts",
    "test:ipfs:gateway-conformance": "tsx scripts/run-gateway-conformance.ts",
    "test:ipfs:nebula": "tsx scripts/run-nebula.ts",
    "test:ipfs:probelab": "tsx scripts/run-probelab.ts",
    "test:ipfs:testground": "tsx scripts/run-testground.ts",
    "test:ipfs:nopfs-badbits": "tsx scripts/run-nopfs-badbits.ts",
    "test:ipfs:node-exposure": "tsx scripts/run-node-exposure.ts",
    "test:ipfs:kubo": "tsx scripts/run-kubo-integrity.ts",
    "test:ipfs:webui": "tsx scripts/run-ipfs-webui.ts",
    "test:ipfs:aegir": "tsx scripts/run-aegir.ts",
    "test:ipfs:schema": "tsx scripts/run-ipld-schema.ts",
    "analyze:bundle": "ANALYZE_BUNDLE=1 npm run build",
    "test:unit": "npm run build-wasm && npm run build-renderer && vitest run",
    "typecheck": "npm run build-wasm && npm run build-renderer && tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/plugin-syntax-typescript": "8.0.3",
    "@biomejs/biome": "2.5.15",
    "@doyensec/csp-evaluator": "1.0.3",
    "@eslint/js": "10.0.1",
    "@ipld/car": "5.4.7",
    "@ipshipyard/libp2p-inspector-metrics": "2.0.0",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/web-components-vite": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.10.0",
    "@types/pa11y": "5.3.7",
    "@types/three": "0.185.4",
    "arktype": "2.2.2",
    "backstopjs": "6.3.25",
    "chromatic": "18.7.2",
    "cypress": "16.0.0",
    "dprint": "0.57.0",
    "eslint": "10.9.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-security": "4.0.1",
    "fake-indexeddb": "6.2.5",
    "html-validate": "11.10.0",
    "knip": "6.34.0",
    "lighthouse": "13.4.1",
    "lightningcss": "1.33.0",
    "lit": "3.3.3",
    "markuplint": "4.18.3",
    "pa11y": "10.0.0",
    "purgecss": "8.0.0",
    "rollup-plugin-visualizer": "7.1.1",
    "start-server-and-test": "3.0.12",
    "storybook": "10.6.0",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "valibot": "1.4.2",
    "vite": "^8.3.3",
    "vitest": "^4.0.0",
    "web-vitals": "6.2.1",
    "wrangler": "4.131.0"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@helia/libp2p": "2.1.3",
    "@libp2p/bootstrap": "12.0.30",
    "@libp2p/circuit-relay-v2": "4.2.12",
    "@libp2p/identify": "4.1.18",
    "@libp2p/kad-dht": "16.4.4",
    "@libp2p/mplex": "12.0.30",
    "@libp2p/ping": "3.1.12",
    "@libp2p/webrtc": "6.0.30",
    "@libp2p/websockets": "10.1.20",
    "@libp2p/webtransport": "6.0.30",
    "helia": "7.1.10",
    "multiformats": "14.0.5",
    "three": "0.185.1",
    "zod": "4.6.1"
  },
  "overrides": {
    "@libp2p/gossipsub": "17.1.1",
    "@node-datachannel/android-arm64": "0.33.4",
    "@puppeteer/browsers": "3.2.2",
    "puppeteer": "25.10.0",
    "puppeteer-core": "25.10.0",
    "postcss-selector-parser@7.1.1": "7.1.6",
    "uuid@13.0.0": "13.0.1",
    "sharp@0.35.4": "0.35.5",
    "undici@7.29.0": "7.29.1",
    "qs@6.15.3": "6.16.0"
  }
}
